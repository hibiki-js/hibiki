{
  "schemaVersion": 1,
  "typePolicy": "Curated structural types, not runtime payload validation or a guarantee for every upstream API version.",
  "providers": {
    "stripe": {
      "package": "@hibiki-js/stripe",
      "version": "0.3.0",
      "format": "snapshot events with data.object; thin events are not supported",
      "events": [
        "charge.dispute.closed",
        "charge.dispute.created",
        "charge.dispute.updated",
        "charge.failed",
        "charge.refunded",
        "charge.succeeded",
        "checkout.session.async_payment_failed",
        "checkout.session.async_payment_succeeded",
        "checkout.session.completed",
        "checkout.session.expired",
        "customer.created",
        "customer.deleted",
        "customer.subscription.created",
        "customer.subscription.deleted",
        "customer.subscription.paused",
        "customer.subscription.resumed",
        "customer.subscription.trial_will_end",
        "customer.subscription.updated",
        "customer.updated",
        "invoice.created",
        "invoice.finalized",
        "invoice.paid",
        "invoice.payment_action_required",
        "invoice.payment_failed",
        "invoice.upcoming",
        "payment_intent.canceled",
        "payment_intent.payment_failed",
        "payment_intent.requires_action",
        "payment_intent.succeeded",
        "payment_method.attached",
        "payment_method.detached",
        "refund.created",
        "refund.updated",
        "setup_intent.succeeded"
      ],
      "specification": "https://docs.stripe.com/api/events/object"
    },
    "github": {
      "package": "@hibiki-js/github",
      "version": "0.3.0",
      "format": "application/json webhook deliveries; event/action pairs are curated",
      "events": [
        "check_run.completed",
        "check_suite.completed",
        "create",
        "delete",
        "deployment.created",
        "deployment_status.created",
        "issue_comment.created",
        "issues.closed",
        "issues.opened",
        "issues.reopened",
        "ping",
        "pull_request.closed",
        "pull_request.labeled",
        "pull_request.opened",
        "pull_request.ready_for_review",
        "pull_request.reopened",
        "pull_request.synchronize",
        "pull_request_review.submitted",
        "push",
        "release.published",
        "workflow_job.completed",
        "workflow_run.completed"
      ],
      "specification": "https://docs.github.com/en/webhooks/webhook-events-and-payloads"
    },
    "discord": {
      "package": "@hibiki-js/discord",
      "version": "0.2.0",
      "format": "signed Discord Interactions (incoming webhooks are a separate outgoing API)",
      "events": [
        "application_command",
        "application_command_autocomplete",
        "message_component",
        "modal_submit",
        "ping"
      ],
      "specification": "https://discord.com/developers/docs/interactions/receiving-and-responding"
    }
  }
}
