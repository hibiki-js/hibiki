{
  "name": "hibiki",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "generate:types": "node scripts/generate-provider-types.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.11",
    "hono": "^4.13.12",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitepress": "1.6.4",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "vite@<6.4.3": "6.4.3",
      "esbuild@<0.28.1": "0.28.1",
      "tinypool@<2.1.2": "2.1.2",
      "source-map-js@<1.2.2": "1.2.2"
    }
  }
}
