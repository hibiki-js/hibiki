{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@hibiki/core": ["packages/core/src/index.ts"],
      "@hibiki/stripe": ["packages/stripe/src/index.ts"],
      "@hibiki/github": ["packages/github/src/index.ts"],
      "@hibiki/hono": ["packages/hono/src/index.ts"],
      "@hibiki/testing": ["packages/testing/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "examples/**/*.ts"]
}
